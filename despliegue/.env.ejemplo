# Copia este archivo a  automatizacion/.env  y llena los valores.
# El .env real esta en .gitignore. NUNCA lo subas a ningun repo.
#
# Verifica todo con:   python automatizacion/verificar.py

# ---------------------------------------------------------------- Firefly III
# Ya los tienes en ../.firefly.env — el verificador los lee de alla si aqui
# estan vacios, asi que puedes dejarlos en blanco.
FIREFLY_URL=
FIREFLY_TOKEN=

# ------------------------------------------------------------ Hotmail (Graph)
# El "Application (client) ID" que te da Entra al registrar la app.
# Es un UUID, algo como 11111111-2222-3333-4444-555555555555
# NO necesita client secret: es una app de cliente publico.
GRAPH_CLIENT_ID=

# consumers = solo cuentas personales (hotmail/outlook/live). Es lo tuyo.
# common    = tambien cuentas de organizacion. Usalo solo si "consumers" falla.
GRAPH_AUTHORITY=consumers

# Tu direccion de Hotmail (solo para saber en que buzon guardar el token).
GRAPH_CUENTA=

# El refresh token de Graph, SOLO para el contenedor. Se deja vacio en
# desarrollo: la primera corrida abre el device flow y te muestra un codigo.
# En el contenedor nadie puede ver ese codigo, asi que hay que darselo hecho:
#   1. En tu maquina: python herramientas/diagnostico.py correo
#   2. python herramientas/generar_variables.py   (lo saca del cache de MSAL)
GRAPH_REFRESH_TOKEN=

# Zona horaria del contenedor. Las alertas del banco vienen en hora local y las
# fechas de los extractos tambien, asi que esto tiene que ser Colombia.
TZ=America/Bogota

# ---------------------------------------------------------- Gmail (IMAP)
# La direccion y el app password de 16 caracteres que genera Google.
# Pegalo SIN espacios.
GMAIL_USUARIO=
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------ Telegram
# El token que te da @BotFather. Formato: 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_TOKEN=

# Se llena solo: corre el verificador, escribele al bot, y te dice tu chat_id.
TELEGRAM_CHAT_ID_JUAN=
TELEGRAM_CHAT_ID_NOVIA=

# ------------------------------------------------------------------ servicio
# Cada cuantos minutos revisar el correo.
INGESTA_INTERVALO_MIN=15
# Hora del resumen diario, y de la conciliacion contra extractos. Vacio = no.
RESUMEN_HORA=21:00
CONCILIAR_HORA=03:30
# Publicar de verdad en Firefly. Arranca en 'no' a proposito.
INGESTA_EN_SERIO=no
# Solo se publica lo de esta fecha en adelante. Vacio = desde hoy.
INGESTA_DESDE=

# El mapeo de productos.csv en UNA linea, con ';' entre filas. Solo hace
# falta al desplegar en un contenedor donde no puedas montar el archivo:
# la UI de Portainer parte las variables por saltos de linea.
# Lo genera:  python herramientas/generar_variables.py
PRODUCTOS_CSV=

# ------------------------------------------------------------------ Gemini
# Para entender respuestas en texto libre ("fue la comida de la gata en
# tierragro"). Se saca gratis en https://aistudio.google.com/apikey
# Sin esto el bot sigue funcionando, solo con emparejamiento por palabras.
GEMINI_API_KEY=
# gemini-3.7-flash: $0.75/$3.75 por millon (precio de intro hasta 31-dic-2026,
#   luego $1.50/$7.50). Es el recomendado: razona bien para el asesor.
# gemini-3.1-flash-lite: $0.25/$1.50, mas barato, suficiente si solo se usa
#   para clasificar.
# NO usar gemini-2.5-flash-lite: se retira el 16-oct-2026.
GEMINI_MODELO=gemini-3.7-flash
# TRAMPA de los modelos que razonan: los tokens que gastan PENSANDO cuentan
# contra el tope de salida. Con un tope justo, la respuesta sale cortada sin
# ningun error. Estos son los presupuestos de pensamiento (0 = apagado):
#   clasificar: 0, porque extraer datos con esquema no necesita razonar
#   asesor: 1024, porque ahi si ayuda a razonar sobre los numeros
GEMINI_THINKING_CLASIFICAR=0
GEMINI_THINKING_ASESOR=1024
# Tope de salida del asesor. Tiene que cubrir pensamiento + respuesta.
GEMINI_MAX_ASESOR=4000

# Modo estricto: publicar sin preguntar solo cuando el comercio coincide exacto
# con algo que TU confirmaste (o que clasificaste 3+ veces igual a mano en
# Firefly). Con 'no' vuelve al umbral de confianza.
CLASIFICADOR_ESTRICTO=si

# Cuantos dias hacia atras trae la PRIMERA bajada. Sin esto un contenedor
# nuevo se traia el buzon completo: 1819 correos de anos atras.
INGESTA_DIAS_INICIAL=30

# Clave de los PDF de extracto de tarjeta (el documento de identidad).
# Sin esto la conciliacion contra extractos no puede abrir los PDF.
EXTRACTO_CLAVE=
