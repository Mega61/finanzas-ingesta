 Salario","last_query_start":"2026-09-01T03:14:01.804484Z","is_remote_synced":false,"dashboard_count":1,"document_id":null,"last_used_at":"2026-09-01T03:14:01.885378Z","dashboard":null,"type":"question","dimensions":null,"average_query_time":424.2012195121951220,"creator_id":1,"can_restore":false,"moderation_reviews":[],"updated_at":"2026-06-27T06:41:37.07742Z","made_public_by_id":null,"embedding_params":null,"cache_ttl":null,"dataset_query":{"lib/type":"mbql/query","database":2,"stages":[{"lib/type":"mbql.stage/native","native":"WITH rango AS (\n  SELECT date_trunc('month', MIN(date)) AS ini,\n         date_trunc('month', MIN(date)) + interval '1 month' AS fin\n  FROM transaction_journals WHERE deleted_at IS NULL AND {{mes}}\n),\nmov AS (\n  SELECT tj.id,\n    MAX(CASE WHEN tt.type='Withdrawal' THEN 1 ELSE 0 END) AS is_wd,\n    MAX(CASE WHEN tt.type='Transfer'   THEN 1 ELSE 0 END) AS is_tr,\n    MAX(tr.amount) AS amount,\n    MAX(CASE WHEN g.tag='Inversión'      THEN 1 ELSE 0 END) AS es_inv,\n    MAX(CASE WHEN g.tag='Extraordinario' THEN 1 ELSE 0 END) AS es_extra,\n    MAX(CASE WHEN g.tag='DeudaFija'      THEN 1 ELSE 0 END) AS es_deuda\n  FROM transaction_journals tj\n  JOIN transaction_types tt ON tt.id=tj.transaction_type_id\n  JOIN transactions tr ON tr.transaction_journal_id=tj.id AND tr.amount>0 AND tr.deleted_at IS NULL\n  JOIN transaction_currencies tc ON tc.id=tr.transaction_currency_id\n  LEFT JOIN tag_transaction_journal ttj ON ttj.transaction_journal_id=tj.id\n  LEFT JOIN tags g ON g.id=ttj.tag_id\n  WHERE tj.deleted_at IS NULL AND tc.code='COP'\n    AND tj.date >= (SELECT ini FROM rango) AND tj.date < (SELECT fin FROM rango)\n  GROUP BY tj.id\n),\nagg AS (\n  SELECT\n    COALESCE(SUM(amount) FILTER (WHERE is_wd=1 AND es_inv=0 AND es_extra=0 AND es_deuda=0),0) AS gastado,\n    COALESCE(SUM(amount) FILTER (WHERE es_inv=1),0) AS invertido,\n    COALESCE(SUM(amount) FILTER (WHERE is_tr=1 AND es_deuda=1),0) AS deuda_fija\n  FROM mov\n)\nSELECT 'Gastado'  AS concepto, gastado    AS monto FROM agg\nUNION ALL SELECT 'Invertido',  invertido  FROM agg\nUNION ALL SELECT 'Deuda fija', deuda_fija FROM agg\nUNION ALL SELECT 'Disponible', GREATEST(7948200 - gastado - invertido - deuda_fija, 0) FROM agg\nORDER BY monto DESC;","template-tags":{"mes":{"widget-type":"date/relative","id":"4e338e0c-9d9b-491f-b5df-c44c660987fb","name":"mes","type":"dimension","dimension":["field",{"lib/uuid":"5ddab90d-8f89-49bb-8e47-a569acca8c85"},629],"display-name":"Mes","default":"thismonth"}}}]},"dimension_mappings":null,"id":41,"legacy_query":null,"parameter_mappings":[],"can_manage_db":true,"display":"pie","archived_directly":false,"entity_id":"QJlhc58F5rQLjzpN5qcX_","param_fields":{"4e338e0c-9d9b-491f-b5df-c44c660987fb":[{"semantic_type":null,"table_id":75,"name":"date","has_field_values":"none","fk_target_field_id":null,"dimensions":[],"id":629,"target":null,"display_name":"Date","name_field":null,"base_type":"type/DateTime"}]},"collection_preview":true,"last-edit-info":{"id":1,"email":"jedazap@hotmail.com","first_name":"Juan","last_name":"Daza","timestamp":"2026-06-27T06:41:37.126684Z"},"visualization_settings":{},"collection":{"authority_level":null,"description":null,"archived":false,"slug":"financiero","archive_operation_id":null,"name":"Financiero","is_remote_synced":false,"personal_owner_id":null,"type":null,"is_sample":false,"id":5,"archived_directly":null,"entity_id":"_P6ImPq3GRNXJdUu-PeJH","location":"/","namespace":null,"is_personal":false,"created_at":"2026-06-25T23:12:56.352066Z"},"metabase_version":"v0.62.3.3 (686cac9)","parameters":[{"id":"4e338e0c-9d9b-491f-b5df-c44c660987fb","type":"date/relative","target":["dimension",["template-tag","mes"]],"name":"Mes","slug":"mes","default":"thismonth","isMultiSelect":true}],"dashboard_id":null,"created_at":"2026-06-25T23:15:14.521076Z","parameter_usage_count":0,"public_uuid":null,"can_delete":false}