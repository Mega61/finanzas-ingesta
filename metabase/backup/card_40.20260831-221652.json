":false,"collection_id":5,"query_type":"native","name":"Gastable por bucket","last_query_start":"2026-09-01T03:14:01.823781Z","is_remote_synced":false,"dashboard_count":1,"document_id":null,"last_used_at":"2026-09-01T03:14:01.885378Z","dashboard":null,"type":"question","dimensions":null,"average_query_time":445.6666666666666667,"creator_id":1,"can_restore":false,"moderation_reviews":[],"updated_at":"2026-06-27T06:42:47.095423Z","made_public_by_id":null,"embedding_params":null,"cache_ttl":null,"dataset_query":{"lib/type":"mbql/query","database":2,"stages":[{"lib/type":"mbql.stage/native","native":"WITH rango AS (\n  SELECT date_trunc('month', MIN(date)) AS ini,\n         date_trunc('month', MIN(date)) + interval '1 month' AS fin\n  FROM transaction_journals WHERE deleted_at IS NULL AND {{mes}}\n),\ngasto AS (\n  SELECT b.id AS budget_id, SUM(t.amount) AS gastado\n  FROM transaction_journals tj\n  JOIN transactions t ON t.transaction_journal_id=tj.id AND t.amount>0 AND t.deleted_at IS NULL\n  JOIN transaction_currencies tc ON tc.id=t.transaction_currency_id\n  JOIN budget_transaction_journal btj ON btj.transaction_journal_id=tj.id\n  JOIN budgets b ON b.id=btj.budget_id\n  JOIN transaction_types tt ON tt.id=tj.transaction_type_id\n  WHERE tt.type='Withdrawal' AND tj.deleted_at IS NULL AND tc.code='COP'\n    AND tj.date >= (SELECT ini FROM rango) AND tj.date < (SELECT fin FROM rango)\n  GROUP BY b.id\n),\ntope AS (\n  SELECT budget_id, SUM(amount) AS presupuestado FROM budget_limits\n  WHERE start_date < (SELECT fin FROM rango) AND end_date >= (SELECT ini FROM rango)\n  GROUP BY budget_id\n)\nSELECT b.name AS bucket,\n       COALESCE(tope.presupuestado,0) AS tope,\n       COALESCE(gasto.gastado,0)      AS gastado,\n       COALESCE(tope.presupuestado,0)-COALESCE(gasto.gastado,0) AS restante,\n       ROUND(100.0*COALESCE(gasto.gastado,0)/NULLIF(tope.presupuestado,0),0) AS pct_usado\nFROM budgets b\nLEFT JOIN gasto ON gasto.budget_id=b.id\nLEFT JOIN tope  ON tope.budget_id=b.id\nWHERE b.active AND b.deleted_at IS NULL AND tope.presupuestado IS NOT NULL\nORDER BY b.name;","template-tags":{"mes":{"widget-type":"date/relative","name":"mes","id":"6eb65771-1931-460d-bee1-f74bd1557a8a","display-name":"Mes","dimension":["field",{"lib/uuid":"ac8a66a5-846c-4fac-91a0-221e510828a4"},629],"type":"dimension","default":"thismonth"}}}]},"dimension_mappings":null,"id":40,"legacy_query":null,"parameter_mappings":[],"can_manage_db":true,"display":"table","archived_directly":false,"entity_id":"b68yAmWjTBQ6nblCoLrnv","param_fields":{"6eb65771-1931-460d-bee1-f74bd1557a8a":[{"semantic_type":null,"table_id":75,"name":"date","has_field_values":"none","fk_target_field_id":null,"dimensions":[],"id":629,"target":null,"display_name":"Date","name_field":null,"base_type":"type/DateTime"}]},"collection_preview":true,"last-edit-info":{"id":1,"email":"jedazap@hotmail.com","first_name":"Juan","last_name":"Daza","timestamp":"2026-06-27T06:42:47.138096Z"},"visualization_settings":{"table.column_formatting":[{"columns":[],"type":"single","operator":"=","value":"","color":"#509EE3","highlight_row":false},{"columns":["pct_usado"],"type":"single","operator":">","value":100,"color":"#EF8C8C","highlight_row":false},{"columns":["pct_usado"],"type":"single","operator":">","value":80,"color":"#F2A86F","highlight_row":false}],"table.row_index":false,"table.freeze_columns":false,"table.freeze_rows":false,"table.pivot_column":"bucket","table.cell_column":"tope","column_settings":{"[\"name\",\"pct_usado\"]":{"column_title":"% Usado","number_style":"decimal"}}},"collection":{"authority_level":null,"description":null,"archived":false,"slug":"financiero","archive_operation_id":null,"name":"Financiero","is_remote_synced":false,"personal_owner_id":null,"type":null,"is_sample":false,"id":5,"archived_directly":null,"entity_id":"_P6ImPq3GRNXJdUu-PeJH","location":"/","namespace":null,"is_personal":false,"created_at":"2026-06-25T23:12:56.352066Z"},"metabase_version":"v0.62.3.3 (686cac9)","p