E tj.deleted_at IS NULL\n    AND tj.date >= (SELECT ini FROM rango) AND tj.date < (SELECT fin FROM rango)\n),\ndeuda AS (\n  SELECT COALESCE(SUM(t.amount),0) actual FROM transaction_journals tj\n  JOIN transactions t ON t.transaction_journal_id=tj.id AND t.amount>0 AND t.deleted_at IS NULL\n  JOIN tag_transaction_journal ttj ON ttj.transaction_journal_id=tj.id\n  JOIN tags g ON g.id=ttj.tag_id AND g.tag='DeudaFija'\n  WHERE tj.deleted_at IS NULL\n    AND tj.date >= (SELECT ini FROM rango) AND tj.date < (SELECT fin FROM rango)\n)\nSELECT pb.concepto, pb.plan, COALESCE(ab.actual,0) AS actual\nFROM plan_budget pb LEFT JOIN actual_budget ab ON ab.concepto=pb.concepto\nUNION ALL SELECT 'Inversión', 1160000, (SELECT actual FROM inv)\nUNION ALL SELECT 'Deuda fija', 261955, (SELECT actual FROM deuda)\nORDER BY plan DESC;","lib/type":"mbql.stage/native","template-tags":{"mes":{"widget-type":"date/relative","name":"mes","id":"2d9c94fa-ec5c-4c6b-8ef3-3fb14151dd3b","display-name":"Mes","dimension":["field",{"lib/uuid":"f8402c4f-75af-4bb8-8981-209b759d7768"},629],"type":"dimension","default":"thismonth"}}}]},"dimension_mappings":null,"id":45,"legacy_query":null,"parameter_mappings":[],"display":"bar","archived_directly":false,"entity_id":"9iBZNf5svMchTXKftLTwM","collection_preview":true,"visualization_settings":{"graph.show_goal":false,"graph.show_values":true,"graph.label_value_frequency":"fit","graph.metrics":["plan","actual"],"graph.label_value_formatting":"auto","graph.x_axis.scale":"ordinal","graph.dimensions":["concepto"],"stackable.stack_type":null,"graph.split_panels":false},"metabase_version":"v0.62.3.3 (686cac9)","parameters":[{"id":"2d9c94fa-ec5c-4c6b-8ef3-3fb14151dd3b","type":"date/relative","target":["dimension",["template-tag","mes"]],"name":"Mes","slug":"mes","default":"thismonth","isMultiSelect":true}],"dashboard_id":2,"created_at":"2026-06-27T06:00:16.432774Z","public_uuid":null},"updated_at":"2026-06-27T06:48:42.01433Z","col":12,"id":42,"parameter_mappings":[{"